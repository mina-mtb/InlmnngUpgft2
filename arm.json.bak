{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "virtualNetworkName": {
            "type": "string",
            "defaultValue": "virtualNetwork",
            "metadata": {
                "description": "The name of the virtual network"
            }
        },
        "subnetName": {
            "type": "string",
            "defaultValue": "subnet",
            "metadata": {
                "description": "The name of the subnet"
            }
        },
        "interfaceName-ReverseProxy": {
            "type": "string",
            "defaultValue": "ReverseProxy",
            "metadata": {
                "description": "The name of the network interface"
            }
        },
        "interfaceName-Bastion": {
            "type": "string",
            "defaultValue": "Bastion",
            "metadata": {
                "description": "The name of the network interface"
            }
        },
        "interfaceName-ASP": {
            "type": "string",
            "defaultValue": "ASP", 
            "metadata": {
                "description": "The name of the network interface"
            }
        },
        "aplicationSecurityGroupNameReverseProxy": {
            "type": "string",
            "defaultValue": "ReverseProxy-ASG",
            "metadata": {
                "description": "The name of the application security group"
            }
        },
        "aplicationSecurityGroupNameBastion": {
            "type": "string",
            "defaultValue": "Bastion-ASG",
            "metadata": {
                "description": "The name of the application security group"
            }
        },
        "aplicationSecurityGroupNameASP": {
            "type": "string",
            "defaultValue": "ASP-ASG",
            "metadata": {
                "description": "The name of the application security group"
            }
        },
        "nsgName": {
            "type": "string",
            "defaultValue": "nsg",
            "metadata": {
                "description": "The name of the network security group"
            }        
        }, 
       "domainNameLabel": {
        "type": "string",
        "defaultValue": "bastion",
        "metadata": {
            "description": "The domain name label for the public IP address"
           }    
        },
       
        "vmName-Bastion": 
        {
            "type": "string",
            "defaultValue": "VM-Bastion",
            "metadata": {
                "description": "The name of the virtual machine"
            }
        },
        "vmName-ASP": 
        {
            "type": "string",
            "defaultValue": "VM-ASP",
            "metadata": {
                "description": "The name of the virtual machine"
            }
        },
        "vmName-ReverseProxy": 
        {
            "type": "string",
            "defaultValue": "VM-ReverseProxy",
            "metadata": {
                "description": "The name of the virtual machine"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "The location of the resources"
            }
        },
        "vmSize": {
            "type": "string",
            "defaultValue": "Standard_B1s",
            "metadata": {
                "description": "The size of the virtual machine"
            }
        },
        "sku": {
            "type": "string",
            "defaultValue": "22_04-lts-gen2",
            "metadata": {
                "description": "The SKU of the image"
            }
        },
        "offer": {
            "type": "string",
            "defaultValue": "0001-com-ubuntu-server-jammy",
            "metadata": {
                "description": "The offer of the image"
            }
        },
        "publisher": {
            "type": "string",
            "defaultValue": "Canonical",
            "metadata": {
                "description": "The publisher of the image"
            }
        },
        "apiversion": {
            "type": "string",
            "defaultValue": "2023-04-01",
            "metadata": {
                "description": "The api version of the resources"
            }
        },
        "containerName": {
            "type": "string",
            "defaultValue": "container",
            "metadata": {
                "description": "The name of the container"
            }
        },
        "sshPublicKey": {
            "type": "securestring",
            "metadata": {
                "description": "The SSH public key"
            }
        },
        "linuxConfiguration": {
            "type": "string",
            "defaultValue": "true",
            "metadata": {
                "description": "The linux configuration"
            }
        },
        "adminUsername": {
            "type": "string",
            "defaultValue": "azureuser",
            "metadata": {
                "description": "The name of the admin user"
            }
        },
        "storageAccountName": {
            "type": "string",
            "defaultValue": "inlamning20140614",
            "metadata": {
                "description": "The name of the storage account"
            }
        }
    },
    "functions": [],
    "variables": {
    "virtualNetworkVariable": "[concat('virtualNetwork-', parameters('virtualNetworkName'))]",
    "subnetVariable": "[concat('subnet-', parameters('subnetName'))]",
    "interfaceVariable-ReverseProxy": "[concat('interface-', parameters('interfaceName-ReverseProxy'))]",
    "interfaceVariable-Bastion": "[concat('interface-', parameters('interfaceName-Bastion'))]",
    "interfaceVariable-ASP": "[concat('interface-', parameters('interfaceName-ASP'))]",
    "nsgVariable": "[concat('nsg-', parameters('nsgName'))]",
    "aplicationSecurityGroupVariableReverseProxy": "[concat('asg-', parameters('aplicationSecurityGroupNameReverseProxy'))]",
    "aplicationSecurityGroupVariableBastion": "[concat('asg-', parameters('aplicationSecurityGroupNameBastion'))]",
    "aplicationSecurityGroupVariableASP": "[concat('asg-', parameters('aplicationSecurityGroupNameASP'))]",
    "publicIpBastionVariable": "bastionPublicIp",
    "publicIpReverseProxyVariable": "reverseProxyPublicIp",
    "virtualMachineVariableReverseProxy": "[concat('VM-', parameters('vmName-ReverseProxy'))]",
    "virtualMachineVariableBastion": "[concat('VM-', parameters('vmName-Bastion'))]",
    "virtualMachineVariableASP": "[concat('VM-', parameters('vmName-ASP'))]",
    "location": "[parameters('location')]",
    "vmSize": "[parameters('vmSize')]",
    "sku": "[parameters('sku')]",
    "offer": "[parameters('offer')]",
    "apiversion": "[parameters('apiversion')]",
    "publisher": "[parameters('publisher')]",    
    "containerName": "[concat('container-', parameters('containerName'))]",
    "adminusername": "[parameters('adminusername')]",
    "sshPublicKey": "[parameters('sshPublicKey')]",
    "linuxConfiguration": "[parameters('linuxConfiguration')]",
    "storageAccountName": "[parameters('storageAccountName')]"
    
},
    "resources": [
        //virtual network
        {
            "name": "[variables('virtualNetworkVariable')]",
            "type": "Microsoft.Network/virtualNetworks",
            "apiVersion": "[variables('apiversion')]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableReverseProxy'))]",
                "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableBastion'))]",
                "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableASP'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgVariable'))]"
            ],
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('virtualNetworkVariable')]"
            },
            "properties": {
                "addressSpace": {
                    "addressPrefixes": [
                        "10.0.0.0/16"
                    ]
                },
                "subnets": [
                    {
                        "name": "[variables('subnetVariable')]",
                        "properties": {
                            "addressPrefix": "10.0.0.0/24",
                            "networkSecurityGroup": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgVariable'))]"
                        }
                    }
                ]
            }
        },
        //application security groups
        //aplicationSecurityGroupReverseProxy
        {
            "name": "[variables('aplicationSecurityGroupVariableReverseProxy')]",
            "type": "Microsoft.Network/applicationSecurityGroups",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('aplicationSecurityGroupVariableReverseProxy')]"
            }
        },
        //aplicationSecurityGroupBastion
        {
            "name": "[variables('aplicationSecurityGroupVariableBastion')]",
            "type": "Microsoft.Network/applicationSecurityGroups",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('aplicationSecurityGroupVariableBastion')]"
            }
        },
        // aplicationSecurityGroupASP
        {
            "name": "[variables('aplicationSecurityGroupVariableASP')]",
            "type": "Microsoft.Network/applicationSecurityGroups",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('aplicationSecurityGroupVariableASP')]"
            }
        },
        //nsg
        {
            "name": "[variables('nsgVariable')]",
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('nsgVariable')]"
            },
            "properties": {
                "securityRules": [
                    {
                        "name": "Allow-ReverseProxy-IN",
                        "properties": {
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "80",
                            "sourceAddressPrefix": "Internet",
                            "destinationApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableReverseProxy'))]"
                                }
                            ],
                            "access": "Allow",
                            "priority": 200,
                            "direction": "Inbound"
                        }
                    },
                    {
                        "name": "Allow-Bastion-IN",
                        "properties": {
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "22",
                            "sourceAddressPrefix": "Internet",
                            "destinationApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableBastion'))]"
                                }
                            ],
                            "access": "Allow",
                            "priority": 201,
                            "direction": "Inbound"
                        }
                    },
                    {
                        "name": "Allow-IN-From-ReverseProxy",
                        "properties": {
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "5000",
                            "sourceApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableReverseProxy'))]"
                                }
                            ],
                            "destinationApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableASP'))]"
                                }
                            ],
                            "access": "Allow",
                            "priority": 202,
                            "direction": "Inbound"
                        }
                    },
                    {
                        "name": "Allow-SSH-IN-From-Bastion",
                        "properties": {
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "22",
                            "sourceApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableBastion'))]"
                                }
                            ],
                            "destinationApplicationSecurityGroups": [
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableASP'))]"
                                },
                                {
                                    "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('aplicationSecurityGroupVariableReverseProxy'))]"
                                }
                            ],
                            "access": "Allow",
                            "priority": 203,
                            "direction": "Inbound"
                        }
                    }
                    


                ]
            }
        },
        //network interfaces
        //network interface-ReverseProxy
        {
            "name": "[variables('interfaceVariable-ReverseProxy')]",
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('interfaceVariable-ReverseProxy')]"
            },
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipconfig1",
                        "properties": {
                            "subnet": {
                                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkVariable'), variables('subnetVariable'))]"
                            }
                        }
                    }
                ]
            }
        },
        //network interface-Bastion
        {
            "name": "[variables('interfaceVariable-Bastion')]",
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('interfaceVariable-Bastion')]"
            },
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipconfig1",
                        "properties": {
                            "subnet": {
                                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkVariable'), variables('subnetVariable'))]"
                            }
                        }
                    }
                ]
            }
        },
        //network interface-ASP
        {
            "name": "[variables('interfaceVariable-ASP')]",
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('interfaceVariable-ASP')]"
            },
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipconfig1",
                        "properties": {
                            "subnet": {
                                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkVariable'), variables('subnetVariable'))]"
                            }
                        }
                    }
                ]
            }
        },
        
        //Public IP
        //publicIp bastion
        {
            "name": "[variables('publicIpBastionVariable')]",
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('publicIpBastionVariable')]"
            },
            "properties": {
                "publicIPAllocationMethod": "Dynamic"
                
            }
        },
        //publicIp ReverseProxy
        {
            "name": "[variables('publicIpReverseProxyVariable')]",
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('publicIpReverseProxyVariable')]"
            },
            "properties": {
                "publicIPAllocationMethod": "Dynamic"
                
            }
        },
        
        // Virtual Machines
        //Virtual Machine-ReverseProxy
        {
            "name": "[variables('virtualMachineVariableReverseProxy')]",
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('virtualMachineVariableReverseProxy')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-ReverseProxy'))]",
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpReverseProxyVariable'))]"
            ],
            "properties": {
                "hardwareProfile": {
                    "vmSize": "[variables('vmSize')]"
                },
                "storageProfile": {
                    "imageReference": {
                        "sku": "[variables('sku')]",
                        "publisher": "[variables('publisher')]",
                        "version": "latest",
                        "offer": "[variables('offer')]"
                    },
                    "osDisk": {
                        "createOption": "FromImage"
                    }
                },
                "osProfile": {
                    "computerName": "[variables('virtualMachineVariableReverseProxy')]",
                    "adminUsername": "[variables('adminusername')]",
                    "adminPassword": "Password1234!",
                    "sshPublicKey": "[variables('sshPublicKey')]", //This is the SSH public key
                    "linuxConfiguration": "[variables('linuxConfiguration')]"
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-ReverseProxy'))]"
                        }
                    ]
                }
            }
        },
        //Virtual Machine-Bastion
        {
            "name": "[variables('virtualMachineVariableBastion')]",
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('virtualMachineVariableBastion')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-Bastion'))]",
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpBastionVariable'))]"
            ],
            "properties": {
                "hardwareProfile": {
                    "vmSize": "[variables('vmSize')]"
                },
                "storageProfile": {
                    "imageReference": {
                        "sku": "[variables('sku')]",
                        "publisher": "[variables('publisher')]",
                        "version": "latest",
                        "offer": "[variables('offer')]"
                    },
                    "osDisk": {
                        "createOption": "FromImage"
                    }
                },
                "osProfile": {
                    "computerName": "[variables('virtualMachineVariableBastion')]",
                    "adminUsername": "[variables('adminusername')]",
                    "adminPassword": "Password1234!",
                    "sshPublicKey": "[variables('sshPublicKey')]",
                    "linuxConfiguration": "[variables('linuxConfiguration')]"
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-Bastion'))]"
                        }
                    ]
                }
            }
        },
        //Virtual Machine-ASP
        {
            "name": "[variables('virtualMachineVariableASP')]",
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "[variables('apiversion')]",
            "location": "[variables('location')]",
            "tags": {
                "displayName": "[variables('virtualMachineVariableASP')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-ASP'))]"
            ],
            "properties": {
                "hardwareProfile": {
                    "vmSize": "[variables('vmSize')]"
                },
                "storageProfile": {
                    "imageReference": {
                        "sku": "[variables('sku')]",
                        "publisher": "[variables('publisher')]",
                        "version": "latest",
                        "offer": "[variables('offer')]"
                    },
                    "osDisk": {
                        "createOption": "FromImage"
                    }
                },
                "osProfile": {
                    "computerName": "[variables('virtualMachineVariableASP')]",
                    "adminUsername": "[variables('adminusername')]",
                    "adminPassword": "Password1234!",
                    "sshPublicKey": "[variables('sshPublicKey')]", //This is the SSH public key
                    "linuxConfiguration":"[variables('linuxConfiguration')]"
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('interfaceVariable-ASP'))]"
                        }
                    ]
                }
            }
        }  ,
        //storage account
        {        
        "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "[variables('apiversion')]",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot"
      }
    },
    //blob storage
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "[variables('apiversion')]",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    //container
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "[variables('apiversion')]",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('containerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
      },
        //CosmosDB(mongoDB)
        {"name": "cosmosDB",
        "type": "Microsoft.DocumentDB/databaseAccounts",
        "apiVersion": "[variables('apiversion')]",
        "location": "[variables('location')]",
        "tags": {
            "displayName": "cosmosDB"
        },
        "properties": {
            "databaseAccountOfferType": "Standard",
            "locations": [
                {
                    "locationName": "[variables('location')]"
                }
            ],
            "capabilities": [
                {
                    "name": "EnableMongo"
                }
            ]
        },
        "kind": "MongoDB"        
 }

      
    ],
    "outputs": {}
}